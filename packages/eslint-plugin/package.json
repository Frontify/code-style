{
    "name": "@frontify/eslint-plugin",
    "type": "module",
    "version": "0.0.1",
    "description": "Shared Frontify lint rules for ESLint and Oxlint",
    "author": "Frontify Developers <developers@frontify.com>",
    "license": "MIT",
    "repository": {
        "directory": "packages/eslint-plugin",
        "type": "git",
